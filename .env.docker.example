# ===== VisualSeek AI - Docker Environment =====

# API server settings
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Database (points to the 'postgres' Docker service)
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@postgres:5432/visionquery

# Encryption key (Fernet base64 url-safe)
ENCRYPTION_KEY=

# Redis (points to the 'redis' Docker service)
REDIS_URL=redis://redis:6379/0

# Milvus (disabled in Docker Desktop setup)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Force offline model loading (no HuggingFace downloads in container)
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
